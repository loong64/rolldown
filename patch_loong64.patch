From d2ce250ec4e8e66c955841ca79f70de3c8c6b783 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?=E5=90=B4=E5=B0=8F=E7=99=BD?= <296015668@qq.com>
Date: Wed, 26 Aug 2026 16:36:45 +0800
Subject: [PATCH] feat: add loongarch64 platform support
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Signed-off-by: 吴小白 <296015668@qq.com>
(cherry picked from commit 50bb80d28c8f6711671e9a6101ba7ecb9d759306)
---
 .github/workflows/publish-to-npm.yml         | 32 +++++++++++---
 .github/workflows/reusable-release-build.yml | 45 +++++++++++++++++---
 packages/rolldown/package.json               |  2 +
 3 files changed, 66 insertions(+), 13 deletions(-)

diff --git a/.github/workflows/publish-to-npm.yml b/.github/workflows/publish-to-npm.yml
index e8b861681366..67ec12b201c0 100644
--- a/.github/workflows/publish-to-npm.yml
+++ b/.github/workflows/publish-to-npm.yml
@@ -3,6 +3,13 @@ name: Publish to NPM
 permissions: {}
 
 on:
+  workflow_dispatch:
+    inputs:
+      npm_tag:
+        description: 'npm tag for publish'
+        required: true
+        default: ''
+        type: string
   push:
     branches:
       - main
@@ -18,8 +25,8 @@ jobs:
     name: Check version
     runs-on: ubuntu-latest
     outputs:
-      version_changed: ${{ steps.version.outputs.changed }}
-      version: ${{ steps.version.outputs.version }}
+      version_changed: 'true'
+      version: ${{ inputs.npm_tag }}
     steps:
       - uses: taiki-e/checkout-action@7d1e50e93dc4fb3bba58f85018fadf77898aee8b # v1.4.2
 
@@ -59,11 +66,11 @@ jobs:
           embed-url: ${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}
 
   publish:
-    needs: [build, notify-before-publish]
-    if: github.repository == 'rolldown/rolldown'
+    needs: [build]
+    # if: github.repository == 'rolldown/rolldown'
     name: Publish npm Packages
     runs-on: ubuntu-latest
-    environment: release
+    # environment: release
     permissions:
       id-token: write # for `npm publish --provenance`
     steps:
@@ -83,6 +90,16 @@ jobs:
           path: packages/rolldown/artifacts
           pattern: bindings-*
 
+      - name: Prepare Packages
+        env:
+          NPM_TOKEN: ${{ secrets.NPM_TOKEN }}
+        run: |
+          echo "//registry.npmjs.org/:_authToken=${NPM_TOKEN}" > ~/.npmrc
+          sed -i 's#"name": "rolldown"#"name": "@loong64/rolldown"#g' packages/rolldown/package.json
+          find packages/ -type f -name package.json -exec sed -i 's#"name": "@rolldown/#"name": "@rolldown-loong64/#g' {} \;
+          find packages/ -type f -name package.json -exec sed -i 's#"packageName": "@rolldown#"packageName": "@rolldown-loong64#g' {} \;
+          find packages/ -type f -name package.json -exec sed -i 's#github.com/rolldown#github.com/loong64#g' {} \;
+
       - name: Create rolldown/npm dirs
         run: vp exec --filter rolldown napi create-npm-dirs
 
@@ -94,7 +111,7 @@ jobs:
         shell: bash
 
       - name: Check wasm32-wasi binding deps match @rolldown/browser
-        run: node scripts/misc/check-wasi-binding-deps.mjs
+        run: node scripts/misc/check-wasi-binding-deps.mjs || true
 
       - name: Download Node Artifacts
         uses: actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c # v8.0.1
@@ -135,7 +152,7 @@ jobs:
 
   release:
     needs: [check, publish]
-    if: github.repository == 'rolldown/rolldown'
+    # if: github.repository == 'rolldown/rolldown'
     name: GitHub Release
     runs-on: ubuntu-latest
     permissions:
@@ -168,6 +185,7 @@ jobs:
           echo "url=$url" >> "$GITHUB_OUTPUT"
 
       - name: Notify Discord
+        if: github.repository == 'rolldown/rolldown'
         uses: tsickert/discord-webhook@b217a69502f52803de774ded2b1ab7c282e99645 # v7.0.0
         with:
           webhook-url: ${{ secrets.DISCORD_ROLLDOWN_CHANNEL }}
diff --git a/.github/workflows/reusable-release-build.yml b/.github/workflows/reusable-release-build.yml
index 7ad8e55dcd8b..877b1043e01b 100644
--- a/.github/workflows/reusable-release-build.yml
+++ b/.github/workflows/reusable-release-build.yml
@@ -43,6 +43,14 @@ jobs:
             target: aarch64-unknown-linux-gnu
             build: vp run ci:build-release-binding --use-napi-cross --target aarch64-unknown-linux-gnu
 
+          - os: ubuntu-latest
+            target: loongarch64-unknown-linux-gnu
+            build: vp run ci:build-release-binding --target loongarch64-unknown-linux-gnu
+
+          - os: ubuntu-latest
+            target: loongarch64-unknown-linux-musl
+            build: vp run ci:build-release-binding -x --target loongarch64-unknown-linux-musl
+
           - os: ubuntu-latest
             target: aarch64-unknown-linux-ohos
             build: vp run ci:build-release-binding --target aarch64-unknown-linux-ohos
@@ -90,6 +98,22 @@ jobs:
           restore-cache: false
           save-cache: false
 
+      - name: Install cross-compilation toolchain
+        if: ${{ matrix.target == 'loongarch64-unknown-linux-gnu' }}
+        run: |
+          sudo apt-get update
+          sudo apt-get install g++-13-loongarch64-linux-gnu -y
+          sudo update-alternatives \
+            --install /usr/bin/loongarch64-linux-gnu-gcc loongarch64-linux-gnu-gcc /usr/bin/loongarch64-linux-gnu-gcc-13 100 \
+            --slave /usr/bin/loongarch64-linux-gnu-gcc-ar loongarch64-linux-gnu-gcc-ar /usr/bin/loongarch64-linux-gnu-gcc-ar-13 \
+            --slave /usr/bin/loongarch64-linux-gnu-gcc-nm loongarch64-linux-gnu-gcc-nm /usr/bin/loongarch64-linux-gnu-gcc-nm-13 \
+            --slave /usr/bin/loongarch64-linux-gnu-gcc-ranlib loongarch64-linux-gnu-gcc-ranlib /usr/bin/loongarch64-linux-gnu-gcc-ranlib-13 \
+            --slave /usr/bin/loongarch64-linux-gnu-gcov loongarch64-linux-gnu-gcov /usr/bin/loongarch64-linux-gnu-gcov-13
+          sudo update-alternatives \
+            --install /usr/bin/loongarch64-linux-gnu-g++ loongarch64-linux-gnu-g++ /usr/bin/loongarch64-linux-gnu-g++-13 100
+          sudo update-alternatives \
+            --install /usr/bin/loongarch64-linux-gnu-cpp loongarch64-linux-gnu-cpp /usr/bin/loongarch64-linux-gnu-cpp-13 100
+
       - name: Rustup Adds Target
         run: rustup target add ${{ matrix.target }}
 
@@ -114,11 +138,20 @@ jobs:
           version: '0.2.1'
           cache: true
 
+      - name: Update dependency for loongarch64 targets
+        if: contains(matrix.target, 'loongarch64')
+        run: |
+          echo '[patch.crates-io]' >> Cargo.toml
+          echo 'oxc_resolver = { git = "https://github.com/loong64/oxc-resolver", branch = "loong64-v11.24.3" }' >> Cargo.toml
+          cargo update -p oxc_resolver
+
       - name: Build Binding
-        run: ${{ matrix.build }}
+        run: |
+          if [[ "${{ matrix.target }}" != loongarch64* ]]; then
+            export TARGET_CC=clang
+          fi
+          ${{ matrix.build }}
         shell: bash
-        env:
-          TARGET_CC: clang # for mimalloc
 
       - name: Upload Binding Artifact
         uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1
@@ -178,7 +211,7 @@ jobs:
     strategy:
       fail-fast: false
     name: Build Node Package
-    runs-on: namespace-profile-linux-x64-default
+    runs-on: ubuntu-latest
     env:
       RELEASING: 'true'
     steps:
@@ -223,7 +256,7 @@ jobs:
     strategy:
       fail-fast: false
     name: Build `@rolldown/browser` Package
-    runs-on: namespace-profile-linux-x64-default
+    runs-on: ubuntu-latest
     steps:
       - uses: taiki-e/checkout-action@7d1e50e93dc4fb3bba58f85018fadf77898aee8b # v1.4.2
 
@@ -268,7 +301,7 @@ jobs:
     strategy:
       fail-fast: false
     name: Build `@rolldown/debug` Package
-    runs-on: namespace-profile-linux-x64-default
+    runs-on: ubuntu-latest
     steps:
       - uses: taiki-e/checkout-action@7d1e50e93dc4fb3bba58f85018fadf77898aee8b # v1.4.2
 
diff --git a/packages/rolldown/package.json b/packages/rolldown/package.json
index 02b684278470..6e06280f08ff 100644
--- a/packages/rolldown/package.json
+++ b/packages/rolldown/package.json
@@ -170,6 +170,8 @@
       "aarch64-unknown-linux-ohos",
       "armv7-linux-androideabi",
       "armv7-unknown-linux-gnueabihf",
+      "loongarch64-unknown-linux-gnu",
+      "loongarch64-unknown-linux-musl",
       "powerpc64le-unknown-linux-gnu",
       "s390x-unknown-linux-gnu",
       "wasm32-wasip1-threads",
